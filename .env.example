# IdP root (no trailing slash). Prefer SSO_BASE_URL; IDP_URL is a Laravel-package alias.
SSO_BASE_URL=https://sso.example.com
# IDP_URL=http://baaboo-sso.test

# Tool identity — from IdP project OAuth credentials screen
SSO_PROJECT_ID=your-tool-slug
SSO_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
SSO_CLIENT_SECRET=replace-me

# This app's public URL — redirect URI is always {APP_URL}/oauth/callback
APP_URL=https://your-tool.example.com

# Optional
SSO_REDIRECT_AFTER_LOGIN=/
SSO_REDIRECT_TO_IDP_LOGOUT=true
# SSO_COOKIE_SECURE=true
# SSO_JWKS_CACHE_TTL=3600
# SSO_HEARTBEAT_INTERVAL_SECONDS=60
